# Testate environment. Every variable is documented in
# docs/technical-specs/11-environment-configuration.md.
PORT=7378
TESTATE_ENV=production
TESTATE_DATA_DIR=/data
TESTATE_BASE_PATH=/
TESTATE_PUBLIC_URL=https://testate.example.internal

# Sealed-value keys. Generate one with: bun scripts/generate-key.ts
# During rotation list the new key first, then the old key (docs/KEY_ROTATION.md).
TESTATE_SECRETS_ACTIVE_KEY=
TESTATE_SECRETS_ACCEPT_UNREADABLE=false

# Bootstrap admin: used only while the users table is empty; the first login
# forces a password change. Remove the password after the first boot.
TESTATE_ADMIN_USER=admin
TESTATE_ADMIN_PASSWORD=

# Recovery for the admin nobody else can reset: set the flag and a new password
# above, restart, sign in, change it, then unset both (DEPLOYMENT_PLAN.md).
# While the flag is set, every restart resets that password again.
# TESTATE_ADMIN_PASSWORD_RESET=true

TESTATE_TRUST_PROXY=true
TESTATE_MAX_UPLOAD_MB=50
TESTATE_JOB_CONCURRENCY=2

# Snapshot store. Unset keeps snapshots on the /data volume.
# TESTATE_STORE=s3
# TESTATE_S3_BUCKET=testate-states
# TESTATE_S3_PREFIX=prod/
# TESTATE_S3_REGION=ap-southeast-1
# TESTATE_S3_ENDPOINT=https://minio.example.internal
# TESTATE_S3_ACCESS_KEY_ID=
# TESTATE_S3_SECRET_ACCESS_KEY=
# TESTATE_S3_VIRTUAL_HOSTED=false

# Wide-event logs: one JSON line per request or job, daily files, rolling window.
# TESTATE_LOG_DIR=/data/logs
TESTATE_LOG_RETENTION_DAYS=30
TESTATE_LOG_STDOUT=true
TESTATE_LOG_SAMPLE_RATE=1
TESTATE_LOG_SLOW_MS=2000
TESTATE_LOG_STACKS=false
