# Running Testate from source. Copy this file to `apps/api/.env`.
#
# Bun reads `.env` from the working directory and does not look upwards, and
# `bun run dev` starts the API with `apps/api` as its working directory, so the
# file has to sit here rather than at the repo root.
#
# Only the first two variables have no usable default. Every variable is
# documented in docs/technical-specs/11-environment-configuration.md, and
# deploy/.env.example is the container's version of this file.

# Required. Generate one with: bun scripts/generate-key.ts
TESTATE_SECRETS_ACTIVE_KEY=

# Required on the first boot only, while the users table is empty. The first
# login forces a password change; remove this afterwards.
TESTATE_ADMIN_PASSWORD=

# Keeps snapshots, the SQLite database and the logs inside the checkout rather
# than at /data, which a source run cannot write.
TESTATE_DATA_DIR=./data

# Relaxes production-only refusals and registers the test-reset route.
TESTATE_ENV=development

PORT=3000
