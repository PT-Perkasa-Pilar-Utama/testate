{
  "name": "@testate/api",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --outdir dist --sourcemap=linked --external \"*.node\" && mkdir -p dist/db && cp -R src/db/migrations dist/db/migrations",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.0",
    "@scalar/hono-api-reference": "0.12.9",
    "@testate/shared": "workspace:*",
    "@valibot/to-json-schema": "1.8.0",
    "basic-ftp": "6.2.1",
    "hono": "4.13.13",
    "hono-openapi": "1.3.3",
    "mongodb": "7.7.0",
    "ssh2": "1.17.0",
    "ssh2-sftp-client": "11.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/ssh2": "1.15.6",
    "@types/ssh2-sftp-client": "9.0.6"
  }
}
