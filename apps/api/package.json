{
  "name": "@testate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=bun --format=esm --outdir dist --sourcemap=linked && mkdir -p dist/db && cp -R src/db/migrations dist/db/migrations",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@hono/standard-validator": "0.2.0",
    "@scalar/hono-api-reference": "0.11.16",
    "@testate/shared": "workspace:*",
    "@valibot/to-json-schema": "1.7.1",
    "hono": "4.13.5",
    "hono-openapi": "1.3.1",
    "valibot": "1.4.2"
  }
}
